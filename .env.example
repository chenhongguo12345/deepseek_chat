# ======== 大模型（LLM）选择 ========
# deepseek（默认）= 调用 DeepSeek 云服务；local = 调用本地 OpenAI 兼容接口（如 Ollama）
LLM_PROVIDER=deepseek

# ---- DeepSeek 云服务（LLM_PROVIDER=deepseek 时生效）----
DEEPSEEK_API_KEY=sk-在此填入你的Key
# DEEPSEEK_MODEL=deepseek-chat

# ---- 本地模型（LLM_PROVIDER=local 时生效，OpenAI 兼容端点，如 Ollama）----
# Ollama 默认提供 http://localhost:11434/v1 兼容端点
LOCAL_BASE_URL=http://localhost:11434/v1
# 必须是本机 ollama list 中已下载的模型名（例如 llama3.2 / qwen2.5:7b 等）
LOCAL_MODEL=llama3.2
# 本地 Ollama 默认无需鉴权，留空即可；兼容端点需要 key 时在此填写
# LOCAL_API_KEY=

# ======== 对象存储选择 ========
# oss = 强制用阿里云 OSS；cos = 强制用腾讯云 COS；
# auto（默认）= 两套都配置齐全时随机选一套（多实例可实现负载分担），
#              只配置一套则用那一套。服务启动时选定，之后一直用这一套。
# 选定后整个进程固定使用，保证文件列表/删除/下载一致。
# STORAGE_CERT_SEL=db（小写）时，四个存储密钥从 MySQL certificate 表读取而非环境变量；
# 默认 env（或其他值）使用下面的环境变量。
STORAGE_CERT_SEL=env
STORAGE_PROVIDER=auto

# ======== 阿里云 OSS 配置 ========
# AccessKey ID 和 Secret（建议用 RAM 子账号，仅授予 OSS 所需权限）
OSS_ACCESS_KEY_ID=你的AccessKeyId
OSS_ACCESS_KEY_SECRET=你的AccessKeySecret
# Endpoint 格式: oss-<region>.aliyuncs.com  例如 oss-cn-hangzhou.aliyuncs.com
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
# Bucket 名称
OSS_BUCKET_NAME=你的Bucket名
# 上传到 OSS 的目录前缀（可留默认）
OSS_KEY_PREFIX=chat/

# ======== 腾讯云 COS 配置（作为 OSS 的备选存储） ========
# SecretId / SecretKey（建议用子账号，仅授予 COS 所需权限）
COS_SECRET_ID=你的SecretId
COS_SECRET_KEY=你的SecretKey
# 地域，例如 ap-shanghai、ap-beijing
COS_REGION=ap-shanghai
# Bucket 名称，格式必须是 <BucketName-APPID>，例如 example-1250000000
COS_BUCKET_NAME=你的Bucket名-APPID
# 上传到 COS 的目录前缀（可留默认）
COS_KEY_PREFIX=chat/

# ======== 数据库选择与配置 ========
# 使用哪种数据库：pgsql（PostgreSQL，默认）或 mysql
DATABASE_SEL=pgsql

# MySQL 配置（DATABASE_SEL=mysql 时使用）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DB=aichat

# PostgreSQL 配置（DATABASE_SEL=pgsql 时使用）
# 首次使用可在登录页点"将 MySQL 数据导入 PostgreSQL"自动建库建表并复制数据
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=123456
PG_DB=aichat
# 会话 Cookie 签名密钥（生产环境务必改成随机长字符串）
SECRET_KEY=请改成一段随机字符串

# ======== Redis 配置（对话上下文缓存，可选） ========
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=无密码则留空
REDIS_DB=0

# ======== 语音识别配置（faster-whisper，可选；未安装依赖时自动停用） ========
# 模型规格：默认 small 模型跑在 CPU 上（WhisperModel("small", device="cpu")）
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
# CPU 推荐 int8（快、省内存）；GPU 可用 float16
WHISPER_COMPUTE=int8
# 识别语言：留空=自动检测；固定中文填 zh，英文填 en
WHISPER_LANGUAGE=
# 初始提示词：留空时中文自动引导简体输出；可填热词提升专有名词准确率
# WHISPER_INITIAL_PROMPT=以下是普通话的句子，请使用简体中文。
# 本地模型目录（配置后不从 HuggingFace 下载，离线部署用）
# WHISPER_MODEL_DIR=D:/models/faster-whisper-small
# 国内下载慢可在启动前设置：set HF_ENDPOINT=https://hf-mirror.com

# ======== 上传限制（可选） ========
# 允许的扩展名（逗号分隔）
ALLOWED_EXTS=jpg,jpeg,png,gif,webp,bmp,pdf,txt,md,doc,docx,xls,xlsx,ppt,pptx,csv
# 单文件最大字节数（默认 10MB = 10485760）
MAX_FILE_SIZE=10485760
